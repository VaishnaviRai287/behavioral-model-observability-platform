# Copy this file to .env and adjust before deploying anywhere beyond local dev.
# docker-compose.yml reads a .env file in this directory automatically.

# Postgres credentials used by both the db service and the api/celery-worker
# connection string. Change these before deploying — the defaults below are
# publicly visible in this repo and provide no real security.
POSTGRES_DB=modelmesh
POSTGRES_USER=modelmesh
POSTGRES_PASSWORD=modelmesh123

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Must be reachable from the user's browser (not a Docker-internal hostname).
# For local docker-compose this is the published host port; for a real
# deployment, set it to the API's public URL. Baked into the frontend's
# client-side bundle at build time — changing it requires `docker compose
# build frontend` again, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000
